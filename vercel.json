{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/docs",
      "destination": "/main.py"
    },
    {
      "source": "/redoc",
      "destination": "/main.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/main.py"
    },
    {
      "source": "/health",
      "destination": "/main.py"
    },
    {
      "source": "/health/(.*)",
      "destination": "/main.py"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|icons\\.svg|probe\\.bin|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
